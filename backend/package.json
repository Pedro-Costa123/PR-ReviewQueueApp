{
  "name": "pr-review-queue-backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Local Supabase schema and authorization checks",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node tool/start.cjs",
    "functions": "supabase --network-id pr-review-queue-local functions serve --env-file .env",
    "stop": "supabase stop",
    "reset": "supabase --network-id pr-review-queue-local db reset --local",
    "lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "test": "node --test --test-concurrency=1 tests/authorization.test.cjs",
    "test:unit": "node --test tests/local-callback.test.cjs tests/email-hook.test.ts tests/hosted-email.test.ts",
    "test:auth": "node --test --test-concurrency=1 tests/local-callback.test.cjs tests/email-hook.test.ts tests/hosted-email.test.ts tests/auth.test.cjs",
    "test:onboarding": "node --test --test-concurrency=1 tests/invite-handler.test.ts tests/onboarding.test.cjs"
  },
  "devDependencies": { "supabase": "2.117.0" }
}
