# Copy to ignored .env.hosted-trial and populate privately, or use provider stores.
# Do not overwrite .env, which belongs to the fictional local Docker stack.
AUTH_EMAIL_MODE=hosted-trial
APP_CALLBACK_URL=http://127.0.0.1:4173/
AUTH_EMAIL_FROM=signin@auth.pedro-costa.dev
TRIAL_RECIPIENTS=REPLACE_WITH_ONE_TO_THREE_CONTROLLED_EMAILS
RESEND_API_KEY=REPLACE_IN_SECRET_STORAGE
SEND_EMAIL_HOOK_SECRET=REPLACE_WITH_PROVIDER_GENERATED_SIGNING_SECRET
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the hosted runtime.
# Turnstile secret goes in Supabase Auth CAPTCHA settings, NOT this file/frontend.
